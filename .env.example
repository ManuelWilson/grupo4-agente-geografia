# API Key de Google para usar modelos Gemini
# Obten tu clave en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Modelo de Gemini usado por el grafo
MODELO=gemini-3.5-flash-lite

# Agente expuesto por `langgraph dev` (lo usan los tests y el supervisor A2A).
# El assistant_id es un UUID que el servidor asigna al grafo: se obtiene con
# POST /assistants/search {"graph_id": ...}
A2A_GEOGRAFIA_URL=http://127.0.0.1:2026
A2A_GEOGRAFIA_GRAPH=agente_profesor_geografia
